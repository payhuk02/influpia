# ============================================================
# Advanced Features Environment Variables
# Influpia - Enterprise SaaS Platform
# ============================================================

# --- Analytics & Reporting ---
ANALYTICS_RETENTION_DAYS=365
REPORT_EXPORT_MAX_ROWS=100000
REPORT_GENERATION_TIMEOUT_SECONDS=300

# --- AI Services ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4
AI_MATCHING_THRESHOLD=0.7
AI_CONTENT_SAFETY_MODEL=content_safety

# --- Content Moderation ---
MODERATION_AUTO_APPROVE_THRESHOLD=0.9
MODERATION_AUTO_REJECT_THRESHOLD=0.3
MODERATION_MAX_RETRIES=3
MODERATION_WEBHOOK_TIMEOUT=10

# --- Email & Notifications ---
EMAIL_FROM=noreply@influpia.com
EMAIL_REPLY_TO=support@influpia.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_resend_api_key
EMAIL_TEMPLATES_PATH=./templates/emails

# --- File Storage ---
S3_BUCKET=influpia-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_CDN_URL=https://cdn.influpia.com
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# --- Rate Limiting ---
RATE_LIMIT_REDIS_URL=redis://localhost:6379
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_DEFAULT_PER_HOUR=1000
RATE_LIMIT_DEFAULT_PER_DAY=10000
RATE_LIMIT_API_PER_MINUTE=100
RATE_LIMIT_WEBHOOK_PER_MINUTE=60

# --- Job Queue (for background tasks) ---
JOB_QUEUE_REDIS_URL=redis://localhost:6379
JOB_QUEUE_CONCURRENCY=10
JOB_QUEUE_MAX_RETRIES=3
JOB_QUEUE_RETRY_DELAY_SECONDS=60

# --- Currency & Exchange Rates ---
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key
EXCHANGE_RATE_UPDATE_INTERVAL_HOURS=24
DEFAULT_CURRENCY=XOF
BASE_CURRENCY=XOF

# --- Subscription & Payments ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
FEDAPAY_SECRET_KEY=your_fedapay_secret_key
FEDAPAY_WEBHOOK_SECRET=your_fedapay_webhook_secret
MONEYFUSION_API_KEY=your_moneyfusion_api_key
PAYMENT_ESCROW_DAYS=7
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# --- Affiliate Program ---
AFFILIATE_COOKIE_DURATION_DAYS=30
AFFILIATE_COMMISSION_DEFAULT_RATE=0.10
AFFILIATE_PAYOUT_THRESHOLD_CENTS=5000
AFFILIATE_PLATFORM_FEE_PERCENT=5

# --- Gamification ---
XP_DAILY_LOGIN_BONUS=10
XP_STREAK_BONUS_MULTIPLIER=2
XP_BADGE_AWARD_MULTIPLIER=1.5
LEADERBOARD_REFRESH_INTERVAL_HOURS=1

# --- Content Scheduling ---
SCHEDULED_CONTENT_AUTO_POST=false
CONTENT_SCHEDULER_TIMEZONE=Africa/Abidjan
CONTENT_APPROVAL_REQUIRED=true

# --- Workflows ---
WORKFLOW_EXECUTION_TIMEOUT_SECONDS=600
WORKFLOW_MAX_STEPS=50
WORKFLOW_DEFAULT_DELAY_HOURS=24

# --- Brand Safety ---
BRAND_SAFETY_CHECK_INTERVAL_DAYS=30
VETTING_REQUIRED_FOR_COLLABORATION=true
DOCUMENT_VERIFICATION_REQUIRED=true

# --- API ---
API_VERSION=v1
API_DOCS_URL=https://docs.influpia.com/api
API_RATE_LIMIT_BURST=20
API_KEY_PREFIX=inf_

# --- Security ---
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30
SESSION_TIMEOUT_MINUTES=30

# --- Monitoring & Logging ---
SENTRY_DSN=your_sentry_dsn
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
ERROR_TRACKING_ENABLED=true

# --- Feature Flags ---
FEATURE_ANALYTICS_ENABLED=true
FEATURE_ADVANCED_SEARCH_ENABLED=true
FEATURE_CONTRACTS_ENABLED=true
FEATURE_DISPUTES_ENABLED=true
FEATURE_SUBSCRIPTIONS_ENABLED=true
FEATURE_AFFILIATES_ENABLED=true
FEATURE_GAMIFICATION_ENABLED=true
FEATURE_MODERATION_ENABLED=true
FEATURE_PUBLIC_API_ENABLED=true
FEATURE_I18N_ENABLED=true
FEATURE_REPORTING_ENABLED=true
FEATURE_BRAND_SAFETY_ENABLED=true
FEATURE_SCHEDULING_ENABLED=true
FEATURE_WORKFLOWS_ENABLED=true

# --- Regional Settings ---
DEFAULT_LANGUAGE=fr
DEFAULT_TIMEZONE=Africa/Abidjan
SUPPORTED_LANGUAGES=fr,en,es,pt,ar,de
SUPPORTED_CURRENCIES=XOF,USD,EUR,GBP,CAD,NGN,KES

# --- Admin Settings ---
ADMIN_EMAIL=admin@influpia.com
SUPPORT_EMAIL=support@influpia.com
ABUSE_REPORT_EMAIL=abuse@influpia.com
